@model EvidencijaStrucnihTestiranja_Sloj_Podataka.Klase_Podataka.VrstaTesta

@{
    ViewData["Title"] = "Izmeni vrstu testa";
}

<h1>Izmeni vrstu testa</h1>

<form asp-controller="VrstaTesta"
      asp-action="Izmeni"
      asp-route-id="@Model.IDVrsteTesta"
      method="post">

    <input type="hidden" asp-for="IDVrsteTesta" />

    <div class="mb-3">
        <label asp-for="Naziv" class="form-label">Naziv</label>
        <input asp-for="Naziv" class="form-control" />
        <span asp-validation-for="Naziv" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="MinimalanBrojPoena" class="form-label">
            Minimalan broj poena
        </label>

        <input asp-for="MinimalanBrojPoena"
               type="text"
               inputmode="numeric"
               class="form-control" />

        <span asp-validation-for="MinimalanBrojPoena"
              class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-warning">
        Sačuvaj izmene
    </button>

    <a asp-controller="VrstaTesta"
       asp-action="Index"
       class="btn btn-secondary">
        Nazad
    </a>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}