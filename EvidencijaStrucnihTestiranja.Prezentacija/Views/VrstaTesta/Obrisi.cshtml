@model EvidencijaStrucnihTestiranja_Sloj_Podataka.Klase_Podataka.VrstaTesta

@{
    ViewData["Title"] = "Obriši vrstu testa";
}

<h1>Obriši vrstu testa</h1>

<div class="alert alert-warning">
    Da li ste sigurni da želite da obrišete ovu vrstu testa?
</div>

<dl class="row">
    <dt class="col-sm-3">ID</dt>
    <dd class="col-sm-9">@Model.IDVrsteTesta</dd>

    <dt class="col-sm-3">Naziv</dt>
    <dd class="col-sm-9">@Model.Naziv</dd>

    <dt class="col-sm-3">Minimalan broj poena</dt>
    <dd class="col-sm-9">@Model.MinimalanBrojPoena</dd>
</dl>

<form asp-controller="VrstaTesta"
      asp-action="ObrisiPotvrda"
      method="post">

    <input type="hidden"
           name="id"
           value="@Model.IDVrsteTesta" />

    <button type="submit" class="btn btn-danger">
        Obriši
    </button>

    <a asp-controller="VrstaTesta"
       asp-action="Index"
       class="btn btn-secondary">
        Odustani
    </a>
</form>