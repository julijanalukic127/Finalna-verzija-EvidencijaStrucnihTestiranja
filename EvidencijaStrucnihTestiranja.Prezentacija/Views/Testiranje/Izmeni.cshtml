@model EvidencijaStrucnihTestiranja_Sloj_Podataka.Klase_Podataka.Testiranje

@{
    ViewData["Title"] = "Izmeni testiranje";
}

<h1>Izmeni testiranje</h1>

<form asp-controller="Testiranje" asp-action="Izmeni" method="post">

    <input type="hidden" asp-for="IDTestiranja" />

    <div class="mb-3">
        <label asp-for="JMBG" class="form-label">Zaposleni</label>

        <select asp-for="JMBG" class="form-control">
            @foreach (var zaposleni in ViewBag.Zaposleni)
            {
                <option value="@zaposleni.JMBG">
                    @zaposleni.Ime @zaposleni.Prezime (@zaposleni.JMBG)
                </option>
            }
        </select>
    </div>

    <div class="mb-3">
        <label asp-for="IDVrsteTesta" class="form-label">Vrsta testa</label>

        <select asp-for="IDVrsteTesta" class="form-control">
            @foreach (var vrsta in ViewBag.VrsteTestova)
            {
                <option value="@vrsta.IDVrsteTesta">
                    @vrsta.Naziv
                </option>
            }
        </select>
    </div>

    <div class="mb-3">
        <label asp-for="DatumTestiranja" class="form-label">Datum testiranja</label>
        <input asp-for="DatumTestiranja" type="date" class="form-control" />
        <span asp-validation-for="DatumTestiranja" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="BrojPoena" class="form-label">Broj poena</label>
        <input asp-for="BrojPoena"
               type="text"
               inputmode="numeric"
               class="form-control" />

        <span asp-validation-for="BrojPoena" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-warning">
        Sačuvaj izmene
    </button>

    <a asp-controller="Testiranje"
       asp-action="Index"
       class="btn btn-secondary">
        Nazad
    </a>

</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}