@model IEnumerable<EvidencijaStrucnihTestiranja_Sloj_Podataka.Klase_Podataka.Testiranje>

@{
    ViewData["Title"] = "Testiranja";
}

<h1>Testiranja</h1>
<a asp-controller="Testiranje"
   asp-action="Dodaj"
   class="btn btn-primary mb-3">
    Dodaj testiranje
</a>
<a asp-controller="Testiranje"
   asp-action="Stampa"
   class="btn btn-secondary mb-3">
    Štampa
</a>
<a asp-controller="Testiranje"
   asp-action="ParametarskaStampa"
   class="btn btn-secondary mb-3">
    Parametarska štampa
</a>
<a asp-controller="Testiranje"
   asp-action="PrikaziXML"
   target="_blank"
   class="btn btn-secondary mb-3">
    XML
</a>

<table class="table">
    <thead>
        <tr>
            <th>JMBG</th>
            <th>Vrsta testa</th>
            <th>Datum testiranja</th>
            <th>Broj poena</th>
            <th>Rezultat</th>
            <th>Akcije</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var testiranje in Model)
        {
            <tr>
                <td>@testiranje.JMBG</td>
                <td>@testiranje.NazivVrsteTesta</td>
                <td>@testiranje.DatumTestiranja.ToShortDateString()</td>
                <td>@testiranje.BrojPoena</td>
                <td>@(testiranje.Polozio ? "Položio" : "Nije položio")</td>
                <td>
                    <a asp-controller="Testiranje"
                       asp-action="Izmeni"
                       asp-route-id="@testiranje.IDTestiranja"
                       class="btn btn-warning">
                        Izmeni
                    </a>

                    <a asp-controller="Testiranje"
                       asp-action="Obrisi"
                       asp-route-id="@testiranje.IDTestiranja"
                       class="btn btn-danger">
                        Obriši
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>