@model EvidencijaStrucnihTestiranja_Sloj_Podataka.Klase_Podataka.Testiranje

@{
    ViewData["Title"] = "Obriši testiranje";
}

<h1>Obriši testiranje</h1>

<div class="alert alert-warning">
    Da li ste sigurni da želite da obrišete ovo testiranje?
</div>

<dl class="row">
    <dt class="col-sm-3">JMBG</dt>
    <dd class="col-sm-9">@Model.JMBG</dd>

    <dt class="col-sm-3">Datum testiranja</dt>
    <dd class="col-sm-9">@Model.DatumTestiranja.ToShortDateString()</dd>

    <dt class="col-sm-3">Broj poena</dt>
    <dd class="col-sm-9">@Model.BrojPoena</dd>

    <dt class="col-sm-3">Rezultat</dt>
    <dd class="col-sm-9">@(Model.Polozio ? "Položio" : "Nije položio")</dd>
</dl>

<form asp-controller="Testiranje"
      asp-action="ObrisiPotvrda"
      method="post">

    <input type="hidden"
           name="id"
           value="@Model.IDTestiranja" />

    <button type="submit" class="btn btn-danger">
        Obriši
    </button>

    <a asp-controller="Testiranje"
       asp-action="Index"
       class="btn btn-secondary">
        Odustani
    </a>

</form>