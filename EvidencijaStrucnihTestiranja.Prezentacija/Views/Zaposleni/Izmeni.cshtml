@model EvidencijaStrucnihTestiranja_Sloj_Podataka.Klase_Podataka.Zaposleni

@{
    ViewData["Title"] = "Izmeni zaposlenog";
}

<h1>Izmeni zaposlenog</h1>

<form asp-controller="Zaposleni" asp-action="Izmeni" method="post">

    <input type="hidden" asp-for="JMBG" />

    <div class="mb-3">
        <label asp-for="JMBG" class="form-label">JMBG</label>
        <input asp-for="JMBG" class="form-control" disabled />
    </div>

    <div class="mb-3">
        <label asp-for="Ime" class="form-label">Ime</label>
        <input asp-for="Ime" class="form-control" />
        <span asp-validation-for="Ime" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Prezime" class="form-label">Prezime</label>
        <input asp-for="Prezime" class="form-control" />
        <span asp-validation-for="Prezime" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="RadnoMesto" class="form-label">Radno mesto</label>
        <input asp-for="RadnoMesto" class="form-control" />
        <span asp-validation-for="RadnoMesto" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Email" class="form-label">Email</label>
        <input asp-for="Email" class="form-control" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-warning">Sačuvaj izmene</button>

    <a asp-controller="Zaposleni"
       asp-action="Index"
       class="btn btn-secondary">
        Nazad
    </a>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}