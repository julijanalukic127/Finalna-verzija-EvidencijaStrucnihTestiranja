@model EvidencijaStrucnihTestiranja_Sloj_Podataka.Klase_Podataka.Zaposleni

@{
    ViewData["Title"] = "Obriši zaposlenog";
}

<h1>Obriši zaposlenog</h1>

<div class="alert alert-warning">
    Da li ste sigurni da želite da obrišete ovog zaposlenog?
</div>

<dl class="row">
    <dt class="col-sm-2">JMBG</dt>
    <dd class="col-sm-10">@Model.JMBG</dd>

    <dt class="col-sm-2">Ime</dt>
    <dd class="col-sm-10">@Model.Ime</dd>

    <dt class="col-sm-2">Prezime</dt>
    <dd class="col-sm-10">@Model.Prezime</dd>

    <dt class="col-sm-2">Radno mesto</dt>
    <dd class="col-sm-10">@Model.RadnoMesto</dd>

    <dt class="col-sm-2">Email</dt>
    <dd class="col-sm-10">@Model.Email</dd>
</dl>

<form asp-controller="Zaposleni"
      asp-action="ObrisiPotvrda"
      method="post">

    <input type="hidden"
           name="jmbg"
           value="@Model.JMBG" />

    <button type="submit" class="btn btn-danger">
        Obriši
    </button>

    <a asp-controller="Zaposleni"
       asp-action="Index"
       class="btn btn-secondary">
        Odustani
    </a>
</form>