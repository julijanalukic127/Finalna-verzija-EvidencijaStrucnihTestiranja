@model ErrorViewModel

@{
    ViewData["Title"] = "Greška";
}

<h1 class="text-danger">Greška.</h1>

<h2 class="text-danger">
    Došlo je do greške prilikom obrade zahteva.
</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>ID zahteva:</strong>
        <code>@Model.RequestId</code>
    </p>
}

<h3>Razvojni režim</h3>

<p>
    U razvojnom režimu moguće je prikazati detaljnije
    informacije o nastaloj grešci.
</p>